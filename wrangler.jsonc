// Cloudflare Pages config for hasit-in-games.
// Usage:
//   npx wrangler d1 create hasit-in-games        # once, record database_id
//   npx wrangler d1 execute hasit-in-games --local --file schema.sql
//   npx wrangler pages dev dist                   # local full-stack dev (port 8788)

{
  "name": "hasit-in-games",
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hasit-in-games",
      "database_id": "c9337b7b-c8f9-4e79-a59c-403807207bdd",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {}
}
